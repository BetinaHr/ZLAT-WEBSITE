---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import ContactHero from "../components/ContactHero.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout
	title="Контакти | ЗЛАТ ЕООД"
	description="Свържете се със ЗЛАТ ЕООД в гр. Свищов за промишлени металдетектори, диагностика, ремонт, калибриране и техническо обслужване."
	keywords="контакти ЗЛАТ ЕООД, промишлени металдетектори Свищов, ремонт на металдетектори, калибриране на металдетектори"
	canonical={new URL("/contacts", Astro.site ?? Astro.url.origin).toString()}
>
	<Navbar />
	<main>
		<ContactHero />
	</main>
	<Footer />
</MainLayout>
