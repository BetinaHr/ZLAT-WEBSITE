---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ServicesPreview from "../components/ServicesPreview.astro";
import GalleryPreview from "../components/GalleryPreview.astro";
import AboutPreview from "../components/AboutPreview.astro";
import ContactPreview from "../components/ContactPreview.astro";
import Footer from "../components/Footer.astro";
import homeContent from "../content/pages/home.json";
---

<MainLayout
	title={homeContent.seo.title}
	description={homeContent.seo.description}
	keywords={homeContent.seo.keywords}
>
	<Navbar />
	<main>
		<Hero />
		<ServicesPreview />
		<GalleryPreview />
		<AboutPreview />
		<ContactPreview />
	</main>
	<Footer />
</MainLayout>
