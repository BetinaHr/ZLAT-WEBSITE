---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import AboutHero from "../components/AboutHero.astro";
import AboutContent from "../components/AboutContent.astro";
import AboutTrustPoints from "../components/AboutTrustPoints.astro";
import ContactPreview from "../components/ContactPreview.astro";
import Footer from "../components/Footer.astro";
import aboutContent from "../content/pages/about.json";
---

<MainLayout
	title={aboutContent.seo.title}
	description={aboutContent.seo.description}
	keywords={aboutContent.seo.keywords}
	canonical={new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/about/`, Astro.site ?? Astro.url.origin).toString()}
>
	<Navbar />
	<main>
		<AboutHero />
		<AboutContent />
		<AboutTrustPoints />
		<ContactPreview />
	</main>
	<Footer />
</MainLayout>
