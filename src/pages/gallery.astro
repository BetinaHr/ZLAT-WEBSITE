---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import GalleryHero from "../components/GalleryHero.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import GalleryFeatured from "../components/GalleryFeatured.astro";
import ContactPreview from "../components/ContactPreview.astro";
import Footer from "../components/Footer.astro";
import galleryContent from "../content/pages/gallery.json";
---

<MainLayout
	title={galleryContent.seo.title}
	description={galleryContent.seo.description}
	keywords={galleryContent.seo.keywords}
>
	<Navbar />
	<main>
		<GalleryHero />
		<GalleryGrid />
		<GalleryFeatured />
		<ContactPreview />
	</main>
	<Footer />
</MainLayout>
