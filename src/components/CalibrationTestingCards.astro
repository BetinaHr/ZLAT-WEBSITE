---
const points = [
	"Тестови карти за калибриране на металдетектор",
	"Проверка на работата на промишлен металдетектор",
	"Различни размери според нуждата",
	"Различни метални сфери за проверка",
	"Помощ при настройка и контрол на чувствителност",
];
---

<section class="bg-[#E9EEF5] py-16 sm:py-20">
	<div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8">
		<div class="max-w-2xl">
			<h2 class="text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">
				Калибриране и проверка с тестови карти
			</h2>
			<p class="mt-5 text-lg leading-8 text-[#334155]">
				Тестови карти за калибриране и проверка работата на промишлени металдетектори. Изработват се с различни размери и от различни метални сфери.
			</p>
			<p class="mt-4 leading-7 text-[#64748B]">
				Тази проверка помага при настройка, контрол на чувствителността и потвърждаване на коректна работа на промишлен металдетектор или металотърсач в производствена линия.
			</p>
			<ul class="mt-7 grid gap-3 sm:grid-cols-2">
				{points.map((point) => (
					<li class="flex gap-3 border border-[#D1D5DC] bg-white p-4 font-bold text-[#0E1629] shadow-sm">
						<span class="mt-2 h-2 w-2 shrink-0 bg-[#DBB24D]" aria-hidden="true"></span>
						<span>{point}</span>
					</li>
				))}
			</ul>
		</div>

		<figure class="overflow-hidden rounded-lg border border-[#D1D5DC] bg-white shadow-xl shadow-[#93A5DF]/20">
			<img class="aspect-[16/11] w-full object-cover" src="/images/photos/P8050738.jpg" alt="Тестови карти за калибриране и проверка на промишлен металдетектор" width="760" height="523" loading="lazy" />
			<figcaption class="border-t border-[#D1D5DC] bg-white p-5 text-sm font-semibold leading-6 text-[#64748B]">
				Тестови карти ZLAT за проверка и калибриране на промишлени металдетектори.
			</figcaption>
		</figure>
	</div>
</section>
