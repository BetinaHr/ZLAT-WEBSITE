---
interface Props {
	src: string;
	title: string;
	caption: string;
	alt: string;
	category: string;
	priority?: boolean;
}

const { src, title, caption, alt, priority = false } = Astro.props;
---

<figure class="group overflow-hidden rounded-lg border border-[#D1D5DC] bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-[#DBB24D] hover:shadow-lg hover:shadow-[#93A5DF]/20">
	<button
		type="button"
		class="relative block w-full cursor-zoom-in overflow-hidden bg-[#EEF1F6] text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-[#93A5DF]"
		data-gallery-trigger
		data-src={src}
		data-alt={alt}
		data-title={title}
		data-caption={caption}
		aria-label={`Уголеми снимка: ${title}`}
	>
		<img
			class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-105"
			src={src}
			alt={alt}
			width="520"
			height="390"
			loading={priority ? "eager" : "lazy"}
		/>
	</button>
	<figcaption class="p-5">
		<h3 class="text-lg font-black text-[#0E1629]">{title}</h3>
		<p class="mt-2 text-sm leading-6 text-[#64748B]">{caption}</p>
	</figcaption>
</figure>
