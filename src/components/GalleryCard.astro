---
interface Props {
	src: string;
	title: string;
	caption: string;
	alt: string;
	category: string;
	priority?: boolean;
}

const { src, title, caption, alt, priority = false } = Astro.props;
---

<figure class="group overflow-hidden rounded-lg border border-[#D1D5DC] bg-white transition duration-200 hover:border-[#3353C1] hover:ring-1 hover:ring-[#3353C1]">
	<button
		type="button"
		class="relative block w-full cursor-zoom-in overflow-hidden bg-[#EEF1F6] text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-[#93A5DF]"
		data-gallery-trigger
		data-src={src}
		data-alt={alt}
		data-title={title}
		data-caption={caption}
		aria-label={`Уголеми снимка: ${title}`}
	>
		<img
			class="aspect-[4/3] w-full object-cover"
			src={src}
			alt={alt}
			width="520"
			height="390"
			loading={priority ? "eager" : "lazy"}
		/>
	</button>
	<figcaption class="p-5">
		<div class="flex items-start justify-between gap-4">
			<h3 class="text-lg font-black text-[#0E1629]">{title}</h3>
			<button
				type="button"
				class="flex size-9 shrink-0 cursor-zoom-in items-center justify-center rounded-full bg-[#EEF1F6] text-[#3353C1] transition-colors hover:bg-[#3353C1] hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3353C1] focus-visible:ring-offset-2 group-hover:bg-[#3353C1] group-hover:text-white"
				data-gallery-trigger
				data-src={src}
				data-alt={alt}
				data-title={title}
				data-caption={caption}
				aria-label={`Уголеми снимка: ${title}`}
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m15 3 6 0 0 6"></path>
					<path d="m9 21-6 0 0-6"></path>
					<path d="M21 3 14 10"></path>
					<path d="m3 21 7-7"></path>
				</svg>
			</button>
		</div>
		<p class="mt-2 text-sm leading-6 text-[#64748B]">{caption}</p>
	</figcaption>
</figure>
