---
import { processSteps } from "../data/services";
---

<section class="bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-3xl">
			<p class="text-sm font-black uppercase tracking-[0.2em] text-[#B98500]">Процес</p>
			<h2 class="mt-3 text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">
				Как ЗЛАТ подхожда към сервиз и индустриални решения
			</h2>
			<p class="mt-4 leading-7 text-[#334155]">
				Подходът зависи от конкретната нужда: диагностика, ремонт, калибриране, производство или интеграция към линия.
			</p>
		</div>

		<div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
			{processSteps.map((step, index) => (
				<article class="relative rounded-lg border border-[#D1D5DC] bg-[#F6F7FA] p-6 shadow-sm">
					<p class="text-4xl font-black text-[#93A5DF]">{String(index + 1).padStart(2, "0")}</p>
					<h3 class="mt-5 text-lg font-black text-[#0E1629]">{step.title}</h3>
					<p class="mt-3 leading-7 text-[#334155]">{step.description}</p>
					<span class="absolute inset-x-6 bottom-0 h-1 bg-[#DBB24D]" aria-hidden="true"></span>
				</article>
			))}
		</div>
	</div>
</section>
