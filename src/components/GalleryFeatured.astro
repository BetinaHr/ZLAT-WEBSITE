---
import galleryContent from "../content/pages/gallery.json";

const visibleItems = galleryContent.items
	.filter((item) => item.published)
	.sort((a, b) => a.order - b.order);
const selectedItems = visibleItems.filter((item) => item.featured);
const featuredGalleryItems = (selectedItems.length >= 3 ? selectedItems : visibleItems).slice(0, 3);
---

<section class="bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="relative isolate overflow-hidden rounded-[2rem] bg-[#3353C1] px-6 py-8 shadow-2xl shadow-[#93A5DF]/30 sm:px-10 sm:py-12 lg:px-14 lg:py-14">
			<div class="absolute inset-0 z-0 opacity-25 [background-image:radial-gradient(#93A5DF_1px,transparent_1px)] [background-size:28px_28px]"></div>
			<div class="relative z-10 grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
				<div>
					<h2 class="max-w-xl text-3xl font-black leading-tight tracking-normal text-white sm:text-4xl">
						{galleryContent.featured.heading}
					</h2>
					<p class="mt-5 max-w-xl text-base leading-7 text-white/90">
						{galleryContent.featured.description}
					</p>

					<ul class="mt-8 grid gap-3" aria-label="Приложения и услуги">
						{galleryContent.featured.points.map((point, index) => (
							<li class="flex items-center gap-4 rounded-2xl border border-white bg-white/95 px-4 py-3.5 text-sm font-bold text-[#0E1629] shadow-sm">
								<span class="grid size-8 shrink-0 place-items-center rounded-xl bg-[#1440BC] text-xs font-black text-white" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="grid gap-4 sm:grid-cols-2 lg:gap-5">
					{featuredGalleryItems.slice(1).map((item, index) => (
						<figure class:list={["overflow-hidden rounded-2xl border-2 border-white bg-white shadow-xl shadow-black/20", index === 1 && "sm:mt-8"]}>
							<button
								type="button"
								class="block w-full cursor-zoom-in overflow-hidden bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-white"
								data-gallery-trigger
								data-src={item.image}
								data-alt={item.imageAlt}
								data-title={item.title}
								data-caption={item.caption}
								aria-label={`Уголеми снимка: ${item.title}`}
							>
								<img class="aspect-[4/3] w-full object-cover" src={item.image} alt={item.imageAlt} width="480" height="360" loading="lazy" />
							</button>
						</figure>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
