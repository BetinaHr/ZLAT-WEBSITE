---
import content from "../content/pages/contacts.json";
---

<section class="bg-white text-[#0E1629]" aria-labelledby="contact-title">
	<div class="relative isolate overflow-hidden border-b border-[#D1D5DC] bg-[#3353C1] text-white">
		<div class="absolute inset-0 -z-10 opacity-25 [background-image:radial-gradient(#93A5DF_1px,transparent_1px)] [background-size:28px_28px]"></div>
		<div class="mx-auto flex min-h-[300px] max-w-7xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8 xl:min-h-[380px] 2xl:min-h-[clamp(440px,48vh,640px)]">
			<h1 id="contact-title" class="max-w-4xl text-4xl font-black leading-tight tracking-normal text-white sm:text-5xl lg:text-[3.75rem] 2xl:max-w-5xl 2xl:text-[4.5rem]">
				{content.hero.heading}
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-[#F8FBFF] 2xl:max-w-3xl 2xl:text-xl 2xl:leading-9">
				{content.hero.description}
			</p>
		</div>
	</div>

	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
		<div class="grid gap-10 md:grid-cols-3 md:gap-0">
			<section class="flex flex-col items-center px-4 text-center md:border-r md:border-[#D1D5DC] lg:px-10" aria-labelledby="contact-phone">
				<span class="flex size-12 items-center justify-center text-[#3353C1]" aria-hidden="true">
					<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92z"></path>
					</svg>
				</span>
				<h2 id="contact-phone" class="mt-4 text-xl font-black">{content.phone.heading}</h2>
				<p class="mt-3 leading-7 text-[#64748B]">{content.phone.description}</p>
				<div class="mt-4 grid gap-1">
					<a class="font-bold text-[#3353C1] hover:text-[#B98500]" href="tel:+359896235203">{content.phone.primaryDisplay}</a>
					<a class="font-semibold text-[#334155] hover:text-[#B98500]" href="tel:+35963143022">{content.phone.secondaryDisplay}</a>
				</div>
			</section>

			<section class="flex flex-col items-center px-4 text-center md:border-r md:border-[#D1D5DC] lg:px-10" aria-labelledby="contact-address">
				<span class="flex size-12 items-center justify-center text-[#3353C1]" aria-hidden="true">
					<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
				</span>
				<h2 id="contact-address" class="mt-4 text-xl font-black">{content.address.heading}</h2>
				<a
					class="group mt-3 block leading-7 text-[#64748B] hover:text-[#3353C1] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#3353C1]"
					href="https://www.google.com/maps/search/?api=1&query=%D0%97%D0%9B%D0%90%D0%A2%20%D0%95%D0%9E%D0%9E%D0%94%2C%20%D1%83%D0%BB.%2033-%D1%82%D0%B8%20%D0%A1%D0%B2%D0%B8%D1%89%D0%BE%D0%B2%D1%81%D0%BA%D0%B8%20%D0%BF%D0%BE%D0%BB%D0%BA%2059%2C%205250%20%D0%A1%D0%B2%D0%B8%D1%89%D0%BE%D0%B2%2C%20%D0%91%D1%8A%D0%BB%D0%B3%D0%B0%D1%80%D0%B8%D1%8F"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Отворете адреса на ЗЛАТ ЕООД в Google Maps"
				>
					<address class="not-italic">
						{content.address.company}<br />
						{content.address.city}<br />
						{content.address.street}
					</address>
					<span class="mt-3 inline-flex items-center gap-1 font-bold text-[#3353C1] underline decoration-[#DBB24D] decoration-2 underline-offset-4 group-hover:text-[#B98500]">
						{content.address.mapLabel}
						<svg class="size-[11px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M7 17 17 7"></path>
							<path d="M7 7h10v10"></path>
						</svg>
					</span>
				</a>
			</section>

			<section class="flex flex-col items-center px-4 text-center lg:px-10" aria-labelledby="contact-email">
				<span class="flex size-12 items-center justify-center text-[#3353C1]" aria-hidden="true">
					<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="16" x="2" y="4" rx="2"></rect>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
					</svg>
				</span>
				<h2 id="contact-email" class="mt-4 text-xl font-black">{content.email.heading}</h2>
				<p class="mt-3 leading-7 text-[#64748B]">{content.email.description}</p>
				<a class="mt-4 font-bold text-[#3353C1] hover:text-[#B98500]" href="mailto:detector@zlat.com">
					{content.email.display}
				</a>
			</section>
		</div>
	</div>
</section>
