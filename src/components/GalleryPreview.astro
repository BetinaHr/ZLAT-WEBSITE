---
const galleryItems = [
	{
		title: "Металдетектор за транспортьор",
		src: "images/photos/Galeria/P1200047.JPG",
		alt: "Промишлен металдетектор, монтиран на транспортна линия",
	},
	{
		title: "Металдетектор с модулна лента",
		src: "images/photos/Galeria/proba3.jpg",
		alt: "Промишлен металдетектор с модулна транспортна лента",
	},
	{
		title: "Гравитачна проверка",
		src: "images/photos/Galeria/PC230782.JPG",
		alt: "Гравитачен промишлен металдетектор",
	},
	{
		title: "Сервиз и тестване",
		src: "images/photos/P8050738.JPG",
		alt: "Тестови карти за калибриране на промишлен металдетектор",
	},
];
---

<section class="bg-white py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
			<div class="max-w-2xl">
				<p class="text-sm font-black uppercase tracking-[0.2em] text-[#B98500]">Галерия</p>
				<h2 class="mt-3 text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">Реални машини и сервизна работа</h2>
				<p class="mt-4 text-base leading-7 text-[#334155]">Снимки от промишлени металдетекторни инсталации, оборудване за проверка и калибриране от ЗЛАТ.</p>
			</div>
			<a href="gallery" class="inline-flex w-fit items-center justify-center border border-[#D1D5DC] px-5 py-3 text-sm font-black uppercase tracking-wide text-[#0E1629] hover:border-[#DBB24D] hover:text-[#1440BC]">
				Вижте галерията
			</a>
		</div>

		<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{galleryItems.map((item) => (
				<figure class="group overflow-hidden border border-[#D1D5DC] bg-[#EEF1F6]">
					<img class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-105" src={item.src} alt={item.alt} loading="lazy" />
					<figcaption class="border-t border-[#D1D5DC] bg-white p-4 text-sm font-bold text-[#334155]">{item.title}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
