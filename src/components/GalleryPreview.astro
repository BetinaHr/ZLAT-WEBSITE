---
import homeContent from "../content/pages/home.json";

const { galleryPreview } = homeContent;
---

<section class="bg-white py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
			<div class="max-w-2xl">
				<h2 class="text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">{galleryPreview.heading}</h2>
				<p class="mt-4 text-base leading-7 text-[#334155]">{galleryPreview.description}</p>
			</div>
			<a href="gallery" class="inline-flex w-fit items-center justify-center border border-[#D1D5DC] px-5 py-3 text-sm font-black uppercase tracking-wide text-[#0E1629] hover:border-[#DBB24D] hover:text-[#1440BC]">
				{galleryPreview.buttonLabel}
			</a>
		</div>

		<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{galleryPreview.items.map((item) => (
				<figure class="overflow-hidden border border-[#D1D5DC] bg-[#EEF1F6]">
					<img class="aspect-[4/3] w-full object-cover" src={item.image} alt={item.imageAlt} loading="lazy" />
					<figcaption class="border-t border-[#D1D5DC] bg-white p-4 text-sm font-bold text-[#334155]">{item.title}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
