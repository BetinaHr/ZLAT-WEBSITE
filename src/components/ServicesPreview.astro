---
const services = [
	{
		title: "Промишлени металдетектори",
		description: "Промишлени металдетектори ZBI и ZPI за транспортни линии, пакетирани продукти, насипни материали, хранителна, текстилна, пластмасова, дърводобивна, въгледобивна и инертна промишленост.",
		marker: "01",
	},
	{
		title: "Ремонт и диагностика",
		description: "Ремонт на промишлени металдетектори собствено и друго производство, както и тестови карти за калибриране и проверка на коректната им работа.",
		marker: "02",
	},
	{
		title: "Индивидуални индустриални решения",
		description: "Решения според конкретния случай за съществуващи транспортьори, свободно падащи продукти, модулни ленти, текстилни ленти и монтаж тип плоча.",
		marker: "03",
	},
];
---

<section class="relative isolate overflow-hidden bg-[#3353C1] py-20 sm:py-24">
	<div class="absolute inset-0 -z-10 opacity-25 [background-image:radial-gradient(#93A5DF_1px,transparent_1px)] [background-size:28px_28px]"></div>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<h2 class="text-3xl font-black tracking-normal text-white sm:text-4xl">Практични детекторни системи и сервиз</h2>
			<p class="mt-4 text-base leading-7 text-white/90">ЗЛАТ произвежда промишлени металдетектори и предлага подходящи решения за конкретни производствени случаи на конкурентни цени.</p>
		</div>

		<div class="mt-10 grid gap-5 md:grid-cols-3">
			{services.map((service) => (
				<article class="border border-[#D1D5DC] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-[#DBB24D] hover:shadow-md">
					<span class="mb-8 inline-flex size-12 items-center justify-center bg-[#3353C1] text-sm font-black text-[#DBB24D]">{service.marker}</span>
					<h3 class="text-xl font-black text-[#0E1629]">{service.title}</h3>
					<p class="mt-3 leading-7 text-[#334155]">{service.description}</p>
					<a href="services" class="mt-6 inline-flex text-sm font-black uppercase tracking-wide text-[#3353C1] hover:text-[#1440BC]">Вижте услугите</a>
				</article>
			))}
		</div>
	</div>
</section>
