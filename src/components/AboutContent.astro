---
import aboutContent from "../content/pages/about.json";
---

<section class="bg-[#F6F7FA] py-20 text-[#0E1629] sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-4xl space-y-5 text-center text-lg leading-8 text-[#334155]">
				<h2 class="text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">
					{aboutContent.overview.heading}
				</h2>
				{aboutContent.overview.paragraphs.map((paragraph) => <p>{paragraph.text}</p>)}
		</div>

		<section aria-labelledby="about-history-title" class="mt-16 rounded-3xl border border-[#B8C2D3] bg-white/70 p-5 sm:p-8">
			<h2 id="about-history-title" class="text-center text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">
				{aboutContent.history.heading}
			</h2>
			<div class="mt-8 grid gap-5 lg:grid-cols-5">
				{aboutContent.history.cards.map((item) => (
					<article class="flex flex-col">
						<p class="mb-3 text-center text-3xl font-black text-[#0E1629]">{item.year}</p>
						<div class="flex flex-1 flex-col rounded-xl bg-[#3353C1] p-5 text-center text-white">
							<img class="mb-5 h-36 w-full rounded-lg bg-white object-contain p-2" src={item.image} alt={item.imageAlt} loading="lazy" />
							<h3 class="text-xl font-black text-white">{item.title}</h3>
							<p class="mt-3 leading-7 text-white/90">{item.text}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section aria-labelledby="about-models-title" class="relative isolate mt-16 overflow-hidden rounded-3xl border border-[#B8C2D3] bg-white/70 p-5 sm:p-8">
			<div class="absolute inset-0 z-0 opacity-30 [background-image:linear-gradient(to_right,#93A5DF_1px,transparent_1px),linear-gradient(to_bottom,#93A5DF_1px,transparent_1px)] [background-size:32px_32px]"></div>
			<div class="relative z-10 text-center">
				<div>
					<h2 id="about-models-title" class="text-3xl font-black tracking-normal text-[#0E1629] sm:text-4xl">
						{aboutContent.models.heading}
					</h2>
				</div>
				<p class="mx-auto mt-4 max-w-xl leading-7 text-[#334155]">
					{aboutContent.models.description}
				</p>
			</div>
			<div class="relative z-10 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
				{aboutContent.models.cards.map((image) => (
					<figure class="border border-[#D1D5DC] bg-white p-4 shadow-sm">
						<img class="h-72 w-full object-contain" src={image.image} alt={image.imageAlt} loading="lazy" />
						<figcaption class="mt-4 border-t border-[#D1D5DC] pt-3 text-center text-lg font-black text-[#0E1629]">{image.label}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<section aria-labelledby="about-work-title" class="mt-16 grid gap-8 border border-[#D1D5DC] bg-white p-6 shadow-sm sm:p-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
			<div>
				<h2 id="about-work-title" class="text-3xl font-black tracking-normal text-[#0E1629]">
					{aboutContent.currentWork.heading}
				</h2>
			</div>
			<p class="text-lg leading-8 text-[#334155]">
				{aboutContent.currentWork.description}
			</p>
		</section>
	</div>
</section>
