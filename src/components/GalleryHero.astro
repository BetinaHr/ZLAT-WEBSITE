---
import galleryContent from "../content/pages/gallery.json";

const visibleItems = galleryContent.items
	.filter((item) => item.published)
	.sort((a, b) => a.order - b.order);
const selectedItems = visibleItems.filter((item) => item.featured);
const heroItems = (selectedItems.length >= 3 ? selectedItems : visibleItems).slice(0, 3);
const [mainImage, ...supportImages] = heroItems;
---

<section class="relative isolate overflow-hidden border-b border-[#D1D5DC] bg-white text-[#0E1629]">
	<div class="absolute inset-0 -z-10 bg-[linear-gradient(135deg,#F8FBFF_0%,#F1F3F7_48%,#E9EEF5_100%)]"></div>
	<div class="mx-auto grid max-w-7xl gap-6 px-4 py-14 sm:px-6 sm:py-18 lg:grid-cols-2 lg:items-stretch lg:gap-6 lg:px-8 lg:py-20 2xl:gap-8 2xl:py-24">
		<div class="relative isolate flex h-full max-w-2xl flex-col items-center justify-center overflow-hidden rounded-lg border border-[#D1D5DC] bg-white p-7 text-center sm:p-10 lg:max-w-none lg:gap-10 lg:p-12">
			<div class="absolute inset-x-0 top-0 z-0 h-3/4 opacity-35 [background-image:linear-gradient(to_right,#93A5DF_1px,transparent_1px),linear-gradient(to_bottom,#93A5DF_1px,transparent_1px)] [background-size:32px_32px] [mask-image:linear-gradient(to_bottom,black_55%,transparent)]"></div>

			<h1 class="relative z-10 max-w-xl text-4xl font-black leading-[1.08] tracking-normal text-[#0E1629] sm:text-5xl lg:text-[3.15rem]">
				{galleryContent.hero.heading}
			</h1>
			<p class="relative z-10 mt-6 max-w-xl text-xl leading-9 text-[#334155] [hyphens:auto] [text-align:justify] [text-align-last:center] lg:mt-0">
				{galleryContent.hero.description}
			</p>
			<div class="relative z-10 mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:mt-0">
				<a href="contacts" class="inline-flex items-center justify-center bg-[#3353C1] px-6 py-3 text-sm font-black uppercase tracking-wide text-white transition hover:bg-[#1440BC]">
					{galleryContent.hero.primaryButtonLabel}
				</a>
				<a href="services" class="inline-flex items-center justify-center border border-[#D1D5DC] bg-white px-6 py-3 text-sm font-black uppercase tracking-wide text-[#0E1629] transition hover:border-[#DBB24D] hover:text-[#1440BC]">
					{galleryContent.hero.secondaryButtonLabel}
				</a>
			</div>
		</div>

		<div class="grid gap-4 sm:grid-cols-2">
			{mainImage && (
				<figure class="overflow-hidden rounded-lg border border-[#D1D5DC] bg-white sm:col-span-2">
					<img class="aspect-[16/9] w-full object-cover" src={mainImage.image} alt={mainImage.imageAlt} width="760" height="428" />
				</figure>
			)}
			{supportImages.map((item) => (
				<figure class="overflow-hidden rounded-lg border border-[#D1D5DC] bg-white">
					<img class="aspect-[4/3] w-full object-cover" src={item.image} alt={item.imageAlt} width="360" height="270" loading="lazy" />
				</figure>
			))}
		</div>
	</div>
</section>
