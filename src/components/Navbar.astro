---
import zlatLogo from "../assets/photos/ZLAT.png";

const navItems = [
	{ href: "", label: "Начало" },
	{ href: "gallery", label: "Галерия" },
	{ href: "services", label: "Услуги" },
	{ href: "about", label: "За нас" },
	{ href: "contacts", label: "Контакти" },
];

const currentPath = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const localPath = currentPath.startsWith(basePath)
	? currentPath.slice(basePath.length)
	: currentPath;
const activePath = localPath.replace(/^\/|\/$/g, "");

const isActive = (href: string) =>
	activePath === href || (href !== "" && activePath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-[#D1D5DC] bg-[#EEF1F6]/95 text-[#0E1629] backdrop-blur">
	<nav class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Основна навигация">
		<a href="" class="block" aria-label="Начало - ZLAT">
			<span class="relative block h-12 w-36 overflow-hidden">
				<img
					src={zlatLogo.src}
					alt="ZLAT"
					width={zlatLogo.width}
					height={zlatLogo.height}
					class="absolute inset-0 h-full w-full scale-[3.4] object-contain"
				/>
			</span>
		</a>

		<div class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 md:flex">
			{navItems.map((item) => (
				<a class:list={["border-b-2 pb-1 text-[0.9625rem] font-semibold transition hover:border-[#DBB24D] hover:text-[#1440BC]", isActive(item.href) ? "border-[#DBB24D] text-[#0E1629]" : "border-transparent text-[#334155]"]} href={item.href}>{item.label}</a>
			))}
		</div>

		<details class="relative md:hidden">
			<summary class="flex cursor-pointer list-none items-center justify-center rounded-md border border-[#D1D5DC] bg-white px-3 py-2 text-[0.9625rem] font-semibold text-[#0E1629] marker:hidden">
				Меню
			</summary>
			<div class="absolute right-0 mt-3 w-48 rounded-md border border-[#D1D5DC] bg-white p-2 shadow-xl">
				{navItems.map((item) => (
					<a class:list={["block rounded px-3 py-2 text-[0.9625rem] font-semibold hover:bg-[#EEF1F6] hover:text-[#1440BC]", isActive(item.href) ? "text-[#B98500]" : "text-[#0E1629]"]} href={item.href}>{item.label}</a>
				))}
			</div>
		</details>
	</nav>
</header>
