---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "ЗЛАТ ЕООД - Промишлени металдетектори",
	description = "ЗЛАТ ЕООД проектира, произвежда, ремонтира и поддържа промишлени металдетектори за производствени линии и специализирани индустриални приложения.",
} = Astro.props;
---

<!doctype html>
<html lang="bg">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-900 antialiased">
		<slot />
	</body>
</html>
